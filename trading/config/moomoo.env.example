# Merge into the local .env; do not commit account identifiers or passwords.
PRISM_US_BROKER=moomoo
MOOMOO_TRADING_MODE=demo
MOOMOO_ALLOW_LIVE=false
MOOMOO_ACCOUNT_NAME=moomoo-us
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
# Required: API acc_id for the US stock SIMULATE account, not the app display number.
MOOMOO_ACCOUNT_ID=
# Required: choose your own budget; no default risk allocation is invented.
MOOMOO_BUY_AMOUNT_USD=
# Explicit no-KIS runtime data configuration.
PRISM_US_MARKET_DATA_SOURCES=yfinance
US_SCREENING_KIS_SHORTLIST=false
US_SNAPSHOT_KIS_DAILY_FALLBACK=false
